
# Binance USDⓈ-M Futures OHLCV Collector

SYMBOL=BTCUSDT
INTERVAL=1m
DB_PATH=data/feed.db
START_DATE=2026-08-01

# REST / Backfill
REST_TIMEOUT_CONNECT=5
REST_TIMEOUT_READ=20
REST_PAGE_LIMIT=1500
REST_REPAIR_INTERVAL=60

# Gap detection
GAP_SCAN_MINUTES=1440

# WebSocket
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10
WS_WATCHDOG_SECONDS=90

# Reconnection
MAX_BACKOFF_SECONDS=60

# Logging
LOG_LEVEL=INFO

# Binance API keys (not required for public market data)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bot (eventos de señal -> signal.db)
SIGNAL_DB=data/signal.db
# Modo live-only: ignora el histórico y publica solo señales desde el arranque.
LIVE_ONLY=true
STRATEGY_TIMEFRAME=30min
STRATEGY_EMA_FAST=55
STRATEGY_EMA_SLOW=200
POLL_SECONDS=30

# Gestión de posición (el bot ejecuta el backtest, así que estos parámetros
# afectan al sizing y a las salidas stop/breakeven/partial). Omitido = default.
#STRATEGY_INITIAL_CAPITAL=10000
#STRATEGY_COMMISSION_BPS=0
#STRATEGY_SLIPPAGE_BPS=0
#STRATEGY_RISK_PCT=0.01
#STRATEGY_MAX_LEVERAGE=1.0
#STRATEGY_STOP_LOSS_PCT=0.01
#STRATEGY_PARTIAL_TP=true
#STRATEGY_PARTIAL_TP_R=1.0
#STRATEGY_PARTIAL_TP_PCT=50
#STRATEGY_MOVE_STOP_TO_BREAKEVEN=true

# Salidas de la estrategia. Vacío/omitido = defaults de strategy.Config,
# por lo que el bot queda alineado con el backtest.
#STRATEGY_ADX_EXIT=true
#STRATEGY_ADX_TIMEFRAME=1D
#STRATEGY_ADX_DILEN=14
#STRATEGY_ADX_ADXLEN=14
#STRATEGY_ADX_KEY_LEVEL=23
#STRATEGY_ADX_EXIT_PCT=100
#STRATEGY_EMA_WEAKENING_EXIT=true
#STRATEGY_EMA_WEAKENING_TIMEFRAME=20min
#STRATEGY_EMA_WEAKENING_GAP_PCT=0.001
#STRATEGY_EMA_WEAKENING_EXIT_PCT=25
#STRATEGY_TIMESTAMP_IS_CLOSE=false
